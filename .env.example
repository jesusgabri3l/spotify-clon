VITE_CLIENT_ID=your-spotify-app-client-id
VITE_REDIRECT_URI=http://127.0.0.1:3000/callback
VITE_AUTH_SPOTIFY_URI=https://accounts.spotify.com/
VITE_AUTH_SPOTIFY_API=https://api.spotify.com/v1/

# Server-only (used by api/token.ts, never exposed to the browser - do NOT
# prefix these with VITE_, that would bundle them into the client). Same
# client ID as above, plus the client secret from the Spotify app dashboard.
SPOTIFY_CLIENT_ID=your-spotify-app-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-app-client-secret
